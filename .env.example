# DB_PASSWORD : mot de passe PostgreSQL. NE JAMAIS commiter de vraie valeur.
# Générer : python -c "import secrets; print(secrets.token_urlsafe(32))"
DB_PASSWORD=CHANGE_ME_GENERATE_STRONG_PASSWORD
# JWT_SECRET : signe les tokens d'auth web + mobile. NE JAMAIS commiter de vraie valeur.
# Le backend (routes/auth.js) ET ai-agent (app.py) fail-fast si non défini.
# Rotation = invalide tous les JWT en cours (re-login utilisateurs web).
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_GENERATE_STRONG_SECRET
# Clé de chiffrement des rapports PCM — doit être différente de JWT_SECRET
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PCM_ENCRYPTION_KEY=
BREVO_API_KEY=
OPENAGENDA_API_KEY=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514

# Web Push (Niveau 2.2) — Générer les clés une fois :
#   npx web-push generate-vapid-keys
# Puis renseigner VAPID_PUBLIC_KEY (exposée au client) et VAPID_PRIVATE_KEY (privée).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@solidata.online

# ───────────────────────────────────────────
# Capteurs LoRaWAN CAV — Orange Live Objects
# ───────────────────────────────────────────
LIVEOBJECTS_ENABLED=false
LIVEOBJECTS_MQTT_URL=mqtts://liveobjects.orange-business.com:8883
LIVEOBJECTS_API_KEY=
LIVEOBJECTS_FIFO_NAME=solidata-cav-uplinks
LIVEOBJECTS_WEBHOOK_SECRET=
LORA_APPKEY_ENCRYPTION_KEY=
# Fenêtre durant laquelle une lecture capteur est considérée "fraîche" pour /fill-rate
# Au-delà, le badge passe en "sensor_stale" mais la valeur reste affichée si présente
SENSOR_FRESHNESS_HOURS=48

# ───────────────────────────────────────────
# Webhook Power Automate — import auto CSV LogicS dans /api/boutique-ventes/webhook-email
# Doit être passé en header X-Webhook-Secret par le flow Power Automate.
# Générer : node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# ───────────────────────────────────────────
BOUTIQUE_WEBHOOK_SECRET=

# ───────────────────────────────────────────
# Module VAK (Vente au Kilo) — Intégration SumUp
#
# Les credentials SumUp (client_id / client_secret) sont SAISIS DANS L'UI à
# /admin/vak/sumup-config et stockés chiffrés dans la table `settings` —
# pas ici. Les variables ci-dessous sont optionnelles.
#
# - SUMUP_REDIRECT_URI : URL de callback OAuth déclarée sur developer.sumup.com,
#   doit pointer vers l'endpoint backend /api/vak/sumup/callback.
# - SUMUP_API_BASE_URL : override API SumUp (utile en dev / sandbox).
# - SUMUP_ENCRYPTION_KEY : clé dédiée pour chiffrer access_token / refresh_token /
#   webhook_secret. Si absente, fallback PCM_ENCRYPTION_KEY puis JWT_SECRET.
# - PUBLIC_BASE_URL : URL publique du backend (utilisée pour enregistrer le webhook
#   côté SumUp). Par défaut : https://solidata.online.
# ───────────────────────────────────────────
SUMUP_REDIRECT_URI=https://solidata.online/api/vak/sumup/callback
# SUMUP_API_BASE_URL=https://api.sumup.com
# SUMUP_ENCRYPTION_KEY=
PUBLIC_BASE_URL=https://solidata.online

# ───────────────────────────────────────────
# Smoke test post-déploiement (deploy.sh étape 7/7)
#
# Identifiants d'un compte ADMIN existant utilisé par scripts/tests/api-smoke.js
# pour vérifier que les ~40 endpoints critiques répondent en 2xx/3xx/401/403.
# Sans ces variables, le smoke ne couvre que les endpoints publics et passe à
# côté des 500 derrière auth (cf. incident du 11/05/2026 — dashboard/kpis SQL).
# ───────────────────────────────────────────
API_USER=
API_PASSWORD=
