# DB_PASSWORD : mot de passe PostgreSQL. NE JAMAIS commiter de vraie valeur.
# Générer : python -c "import secrets; print(secrets.token_urlsafe(32))"
DB_PASSWORD=CHANGE_ME_GENERATE_STRONG_PASSWORD
# JWT_SECRET : signe les tokens d'auth web + mobile. NE JAMAIS commiter de vraie valeur.
# Le backend (routes/auth.js) ET ai-agent (app.py) fail-fast si non défini.
# Rotation = invalide tous les JWT en cours (re-login utilisateurs web).
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_GENERATE_STRONG_SECRET
# Clé de chiffrement des rapports PCM — doit être différente de JWT_SECRET
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PCM_ENCRYPTION_KEY=
# Double authentification (2.43.0) — chiffre le secret TOTP (users.mfa_secret).
# Optionnelle mais RECOMMANDÉE : sans elle, repli sur PCM_ENCRYPTION_KEY puis
# JWT_SECRET (fonctionne, mais mélange deux registres de compromission).
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MFA_ENCRYPTION_KEY=
BREVO_API_KEY=
OPENAGENDA_API_KEY=
ANTHROPIC_API_KEY=

# Événements de circulation (accidents, bouchons, fermetures) sur la carte
# « Collecte en direct ». Clé TomTom, produit « Traffic Incidents API ».
# NE PAS activer le « domain whitelisting » côté TomTom : les appels partent
# du serveur, pas du navigateur. Sans clé, la carte affiche un message clair
# plutôt qu'une carte vide qu'on prendrait pour « aucune perturbation ».
TOMTOM_API_KEY=

# Routeur OSRM : distances et tracés routiers des tournées.
# Laisser vide utilise le serveur de démonstration public (gratuit, sans
# engagement de service). Les tronçons calculés sont mis en cache en base
# (table route_legs_cache), ce qui rend l'appel rare une fois la zone couverte.
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_TIMEOUT_MS=4000

# Modèle Claude utilisé par l'assistant et les analyses IA.
# Laisser vide : l'application applique son défaut, défini de façon identique
# dans le code et dans docker-compose.prod.yml. Ne renseignez cette variable
# que pour forcer un autre modèle — une valeur figée ici finit par désigner un
# modèle retiré sans que personne s'en aperçoive, et l'appel échoue alors en
# 404 côté Anthropic.
CLAUDE_MODEL=

# Web Push (Niveau 2.2) — Générer les clés une fois :
#   npx web-push generate-vapid-keys
# Puis renseigner VAPID_PUBLIC_KEY (exposée au client) et VAPID_PRIVATE_KEY (privée).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@solidata.online

# ───────────────────────────────────────────
# Capteurs LoRaWAN CAV — Orange Live Objects
# ───────────────────────────────────────────
LIVEOBJECTS_ENABLED=false
LIVEOBJECTS_MQTT_URL=mqtts://liveobjects.orange-business.com:8883
LIVEOBJECTS_API_KEY=
LIVEOBJECTS_FIFO_NAME=solidata-cav-uplinks
LIVEOBJECTS_WEBHOOK_SECRET=
LORA_APPKEY_ENCRYPTION_KEY=
# Fenêtre durant laquelle une lecture capteur est considérée "fraîche" pour /fill-rate
# Au-delà, le badge passe en "sensor_stale" mais la valeur reste affichée si présente
SENSOR_FRESHNESS_HOURS=48

# ───────────────────────────────────────────
# Webhook Power Automate — import auto CSV LogicS dans /api/boutique-ventes/webhook-email
# Doit être passé en header X-Webhook-Secret par le flow Power Automate.
# Générer : node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# ───────────────────────────────────────────
BOUTIQUE_WEBHOOK_SECRET=

# ───────────────────────────────────────────
# Module VAK (Vente au Kilo) — Intégration SumUp
#
# Les credentials SumUp (client_id / client_secret) sont SAISIS DANS L'UI à
# /admin/vak/sumup-config et stockés chiffrés dans la table `settings` —
# pas ici. Les variables ci-dessous sont optionnelles.
#
# - SUMUP_REDIRECT_URI : URL de callback OAuth déclarée sur developer.sumup.com,
#   doit pointer vers l'endpoint backend /api/vak/sumup/callback.
# - SUMUP_API_BASE_URL : override API SumUp (utile en dev / sandbox).
# - SUMUP_ENCRYPTION_KEY : clé dédiée pour chiffrer access_token / refresh_token /
#   webhook_secret. Si absente, fallback PCM_ENCRYPTION_KEY puis JWT_SECRET.
# - PUBLIC_BASE_URL : URL publique du backend (utilisée pour enregistrer le webhook
#   côté SumUp). Par défaut : https://solidata.online.
# ───────────────────────────────────────────
SUMUP_REDIRECT_URI=https://solidata.online/api/vak/sumup/callback
# SUMUP_API_BASE_URL=https://api.sumup.com
# SUMUP_ENCRYPTION_KEY=
# Scopes OAuth séparés par espace ou virgule. Le défaut "transactions.history"
# suffit pour la sync des ventes. Ajouter ici les scopes additionnels SI ils
# sont activés sur l'app côté developer.sumup.com (ex: payments,
# user.profile_readonly) — sinon SumUp refuse avec invalid_scope.
# SUMUP_OAUTH_SCOPES=transactions.history
PUBLIC_BASE_URL=https://solidata.online

# ───────────────────────────────────────────
# Smoke test post-déploiement (deploy.sh étape 7/7)
#
# SMOKE_API_KEY — clé d'API de SERVICE, en LECTURE SEULE, utilisée par
# scripts/tests/api-smoke.js pour vérifier que les ~40 endpoints critiques
# répondent (et surtout qu'aucun ne renvoie 500 derrière l'authentification —
# cf. incident du 11/05/2026, dashboard/kpis).
#
# Elle REMPLACE le trio API_USER / API_PASSWORD / API_TOTP_SECRET (2.45.0) :
# ce compte ADMIN de service rangeait ses DEUX facteurs d'authentification au
# même endroit, ce qui annulait le bénéfice de la double authentification. Une
# clé est un secret unique, à portée limitée, révocable et expirable, qui
# n'ouvre aucune session humaine et ne peut RIEN écrire.
#
# Création (dans le conteneur backend) :
#   node src/scripts/creer-cle-api.js --apply
# La clé n'est affichée qu'une seule fois — la base n'en garde que le hash.
# Révocation immédiate :
#   node src/scripts/creer-cle-api.js --revoquer=<préfixe>
#
# Sans elle, le smoke ne couvre que les endpoints publics : il l'annonce et le
# déploiement se poursuit (une couverture réduite n'est pas une régression).
# ───────────────────────────────────────────
SMOKE_API_KEY=
