[Unit]
Description=Affichage kiosque du poste de pointage SOLIDATA
Documentation=file:/opt/badgeuse/README.md
# L'interface est servie par l'agent (http://127.0.0.1:8766) : sans agent,
# rien a afficher.
After=badgeuse-agent.service systemd-user-sessions.service
Requires=badgeuse-agent.service

[Service]
User=badgeuse
Group=badgeuse
SupplementaryGroups=video render input tty

# Session graphique minimale : cage (compositeur Wayland) sur la console 1.
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes

Environment=XDG_SESSION_TYPE=wayland
# cage peut se bloquer AVANT toute sortie s'il attend la prise de controle du
# seat aupres de logind (session inactive) — constate en exploitation : cage
# vivant 8 minutes, aucun client lance, aucune ligne au journal, SIGTERM
# ignore. libseat, lui, sait dire ou il en est : on le rend bavard, sa sortie
# part au journal du service (StandardError=journal ci-dessous).
Environment=LIBSEAT_LOGLEVEL=debug
Environment=XDG_RUNTIME_DIR=/run/badgeuse
# Les options de Chromium propres a la cible (Pi 5 / Pi 3) sont ecrites par
# install.sh : le code applicatif, lui, est identique sur les deux machines.
EnvironmentFile=/etc/badgeuse/kiosk.env

RuntimeDirectory=badgeuse
RuntimeDirectoryMode=0700

# Purge des sessions logind residuelles AVANT d'ouvrir la notre. Constate en
# exploitation : la session PAM du premier demarrage (ecran noir, cage tue en
# SIGKILL) restait enregistree et DETENAIT seat0/tty1 — chaque redemarrage du
# kiosque recevait alors une session neuve SANS seat, et cage attendait en
# silence un controle que logind ne pouvait plus lui accorder. On repart
# proprement : les sessions de l'utilisateur badgeuse sont cloturees (l'agent,
# service systeme, n'en fait pas partie et n'est pas touche) et le VT1 revient
# au premier plan. Prefixe « + » : ces gestes exigent root, le service, lui,
# reste sous l'utilisateur badgeuse. Jamais bloquant (exit 0).
ExecStartPre=+/bin/sh -c 'loginctl terminate-user badgeuse 2>/dev/null; sleep 1; chvt 1 2>/dev/null; exit 0'

# L'attente laisse a l'agent le temps d'ouvrir son serveur local.
ExecStartPre=/bin/sleep 3

# La commande REELLE est posee par install.sh dans le drop-in
# /etc/systemd/system/badgeuse-kiosk.service.d/lancement.conf : le compositeur
# (cage ou repli X11) et le chemin du navigateur (/usr/bin/chromium ou
# /usr/bin/chromium-browser selon la distribution) ne se devinent pas ici.
#
# Cette ligne n'est donc PAS une valeur par defaut : c'est un refus explicite.
# Une commande devinee qui n'existe pas echoue en 203/EXEC — un ecran noir
# sans message, exactement le symptome qu'on a mis une journee a nommer sur le
# terrain. Ici, le journal dit quoi faire.
ExecStart=/bin/sh -c 'echo "kiosque non configure : le drop-in lancement.conf est absent — relancer sudo bash /opt/badgeuse/deploy/install.sh --target pi5|pi3" >&2; exit 1'

Restart=always
RestartSec=5

# cage ne rend pas la main promptement sur SIGTERM : sans borne, systemd
# applique son defaut de 90 s avant le SIGKILL. Un simple « restart » laissait
# donc l'ecran mort une minute et demie (constate en exploitation : « Stopping »
# a 10:35:37, « stop-sigterm timed out. Killing » a 10:37:07). Le kiosque est un
# afficheur sans etat a preserver : 10 s suffisent largement, ensuite on tue.
TimeoutStopSec=10

NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=graphical.target multi-user.target
