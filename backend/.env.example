DB_HOST=localhost
DB_PORT=5432
DB_NAME=solidata
DB_USER=solidata_user
# Génère un mot de passe fort, jamais cette valeur en prod :
# node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
DB_PASSWORD=CHANGE_ME_GENERATE_STRONG_PASSWORD
# Génère un secret JWT, jamais cette valeur en prod :
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_GENERATE_STRONG_SECRET
# Clé de chiffrement des rapports PCM — doit être différente de JWT_SECRET
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PCM_ENCRYPTION_KEY=CHANGE_ME_GENERATE_STRONG_KEY
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d
PORT=3001
NODE_ENV=development
BREVO_API_KEY=
CENTRE_TRI_LAT=49.4231
CENTRE_TRI_LNG=1.0993

# ───────────────────────────────────────────
# Capteurs LoRaWAN CAV — Orange Live Objects
# ───────────────────────────────────────────
# Flag principal : met à true pour activer le worker MQTT
LIVEOBJECTS_ENABLED=false
# Broker MQTT Orange Live Objects
LIVEOBJECTS_MQTT_URL=mqtts://liveobjects.orange-business.com:8883
# API key Live Objects (rôle minimum BUS_READ) — username MQTT = "application"
LIVEOBJECTS_API_KEY=
# Nom de la FIFO Live Objects routant les uplinks LoRa (créée côté plateforme)
LIVEOBJECTS_FIFO_NAME=solidata-cav-uplinks
# Secret partagé pour le webhook HTTP (fallback) — à configurer aussi côté Live Objects
LIVEOBJECTS_WEBHOOK_SECRET=
# Clé de chiffrement AES-256 des AppKey LoRaWAN stockées (fallback: JWT_SECRET)
LORA_APPKEY_ENCRYPTION_KEY=
# Fenêtre de fraîcheur capteur — au-delà on retombe sur l'heuristique
SENSOR_FRESHNESS_HOURS=8

# ───────────────────────────────────────────
# Webhook Power Automate — imports boutiques
# ───────────────────────────────────────────
# Secret partagé pour le webhook HTTP Power Automate (réception CSV Outlook)
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Doit être identique côté Power Automate (header X-Webhook-Secret)
BOUTIQUE_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# APP_VERSION — version de l'outil portée par l'EN-TÊTE DE TRAÇABILITÉ des
# documents transmis à l'autorité de tutelle : export FSE+ participants,
# tableau des freins (d), synthèse de dialogue de gestion (e). Elle est aussi
# enregistrée dans le snapshot de chaque synthèse générée — sans elle, rejouer
# une synthèse ne dira jamais quelle version l'a produite, ce qui prive le
# snapshot d'une part de sa valeur probante.
# La mentionner est une RÈGLE COMMUNE IMPÉRATIVE de la matrice de l'autorité.
# Laisser vide : repli sur `backend/package.json`, tenu à jour au même commit
# que `CLAUDE.md`. Ne jamais laisser les deux à « 1.0.0 ».
APP_VERSION=2.55.0
